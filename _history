adóx, Támadóy, 10)\nOLED.draw_filled_circle(Ellensegx, Ellensegy, 10)\nOLED.draw_filled_circle(Ellensegx + 20, Ellensegy, 10)\nOLED.draw_filled_circle(Ellensegx + 40, Ellensegy, 10)\n\ndef on_forever():\n    pass\nbasic.forever(on_forever)\n","pxt.json":"{\n    \"name\": \"urkaland\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"tinkercademy-tinker-kit\": \"github:tinkertanker/pxt-tinkercademy-tinker-kit#v1.1.1\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"preferredEditor\": \"blocksprj\"\n}\n"}}],"shares":[],"lastSaveTime":1793715775536}